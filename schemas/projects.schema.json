{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projects",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "required": ["slug", "title", "role", "problem", "solution", "stack", "outcome", "diagram"],
    "additionalProperties": false,
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": { "type": "string", "minLength": 1 },
      "role": { "type": "string" },
      "period": { "type": "string" },
      "problem": { "type": "string", "minLength": 20 },
      "solution": { "type": "string", "minLength": 20 },
      "stack": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 3
      },
      "outcome": { "type": "string", "minLength": 10 },
      "confidentiality": {
        "type": "string",
        "enum": ["public", "generic-enterprise"],
        "default": "public"
      },
      "diagram": {
        "type": "object",
        "required": ["path", "alt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(diagrams|projects)/[a-z0-9-]+\\.(svg|jpg|jpeg|png)$"
          },
          "alt": { "type": "string", "minLength": 10 }
        }
      },
      "architectureDiagram": {
        "type": "object",
        "required": ["path", "alt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(diagrams|projects)/[a-z0-9-]+\\.(svg|jpg|jpeg|png)$"
          },
          "alt": { "type": "string", "minLength": 10 }
        }
      },
      "screenshot": {
        "type": "object",
        "required": ["path", "alt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(diagrams|projects)/[a-z0-9-]+\\.(svg|jpg|jpeg|png)$"
          },
          "alt": { "type": "string", "minLength": 10 }
        }
      },
      "metrics": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["value", "label"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 }
          }
        }
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "url"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        }
      },
      "snippets": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "language", "code"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "language": { "type": "string", "minLength": 1 },
            "code": { "type": "string", "minLength": 10 }
          }
        }
      },
      "displayOrder": { "type": "integer", "minimum": 1, "maximum": 4 }
    }
  }
}
