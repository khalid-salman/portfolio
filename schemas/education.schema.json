{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "education",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["degree", "institution", "period", "grade"],
    "properties": {
      "degree": { "type": "string", "minLength": 1 },
      "institution": { "type": "string", "minLength": 1 },
      "location": { "type": "string" },
      "period": { "type": "string" },
      "grade": { "type": "string" },
      "displayOrder": { "type": "integer" }
    }
  }
}
