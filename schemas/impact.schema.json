{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impact",
  "type": "object",
  "required": ["metrics"],
  "properties": {
    "metrics": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "maxLength": 60 },
          "description": { "type": "string", "maxLength": 120 }
        }
      }
    }
  }
}
