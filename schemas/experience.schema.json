{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experience",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["company", "title", "location", "startDate", "endDate", "highlights"],
    "additionalProperties": false,
    "properties": {
      "company": { "type": "string" },
      "title": { "type": "string" },
      "location": { "type": "string" },
      "employmentType": { "type": "string" },
      "startDate": { "type": "string", "pattern": "^\\d{2}/\\d{4}$" },
      "endDate": {
        "type": "string",
        "pattern": "^(\\d{2}/\\d{4}|Present)$"
      },
      "highlights": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1,
        "maxItems": 4
      },
      "displayOrder": { "type": "integer" }
    }
  }
}
