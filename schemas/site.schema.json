{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site",
  "type": "object",
  "required": ["owner", "seo", "contact", "footer"],
  "additionalProperties": false,
  "properties": {
    "owner": {
      "type": "object",
      "required": ["name", "title", "tagline", "location"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "availability": { "type": "string", "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 240 },
        "summary": { "type": "string", "maxLength": 800 },
        "summaries": {
          "type": "array",
          "items": { "type": "string", "minLength": 20 },
          "minItems": 1,
          "maxItems": 4
        },
        "bestFit": { "type": "string", "maxLength": 200 },
        "location": { "type": "string" },
        "photo": { "type": "string", "pattern": "^/" }
      }
    },
    "seo": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "ogImage": { "type": "string", "pattern": "^/" }
      }
    },
    "contact": {
      "type": "object",
      "required": ["email", "linkedin"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "pattern": "^\\+[0-9]{10,15}$" },
        "linkedin": { "type": "string", "format": "uri" },
        "github": { "type": "string", "format": "uri" }
      }
    },
    "footer": {
      "type": "object",
      "required": ["pipelineNote", "repositoryUrl"],
      "properties": {
        "pipelineNote": { "type": "string" },
        "repositoryUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
